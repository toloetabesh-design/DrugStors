<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\internal-nlog-AspNetCore.txt">

	<!-- اجازه دسترسی به ویژگی‌های ASP.NET Core -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>

	<!-- تعریف مقصدها: کجا ذخیره شود؟ -->
	<targets>
		<!-- ۱. ذخیره در کنسول (برای دیدن لحظه‌ای در ویژوال استودیو) -->
		<target xsi:type="Console" name="logconsole"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />

		<!-- ۲. ذخیره در فایل (در پوشه Logs پروژه) -->
		<target xsi:type="File" name="logfile" fileName="Logs/app-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />
	</targets>

	<!-- تعیین اینکه چه چیزهایی کجا نوشته شود -->
	<rules>
		<logger name="*" minlevel="Info" writeTo="logconsole,logfile" />
	</rules>
</nlog>
